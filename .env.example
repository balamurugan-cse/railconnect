# Environment configuration for RailConnect

# GEMINI_API_KEY: Optional for AI Studio runtime integration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this applet is hosted
APP_URL="http://localhost:3000"

# Server configuration
PORT=3000
NODE_ENV="development"

# Database connection (for PostgreSQL when deployed)
DATABASE_URL="postgresql://railconnect:railconnect_secret@localhost:5432/railconnect_db?schema=public"

# Authentication Secrets
JWT_SECRET="railconnect-super-secret-jwt-key-min-32-chars-long"
JWT_REFRESH_SECRET="railconnect-super-secret-refresh-key-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Railway Provider Configuration
# Allowed modes: "demo" (default) or "authorized"
RAILWAY_PROVIDER_MODE="demo"
AUTHORIZED_RAILWAY_API_URL="https://api.irctc-authorized-partner.gov.in/v1"
AUTHORIZED_RAILWAY_API_KEY="placeholder_api_key_requires_commercial_agreement"

# Payment Gateway Configuration
# Allowed modes: "sandbox" (default), "razorpay", or "stripe"
PAYMENT_PROVIDER_MODE="sandbox"
PAYMENT_WEBHOOK_SECRET="sandbox_webhook_secret_key_railconnect"
